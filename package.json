{
  "name": "brows3r",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "perf": "vitest run --reporter=verbose src/views/modes/__perf__/details.perf.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:api:ts": "typedoc",
    "docs:api:rust": "cd src-tauri && cargo doc --no-deps --document-private-items && mkdir -p ../dist-docs/api/rust && cp -R target/doc/* ../dist-docs/api/rust/ && cd .. && (test -f dist-docs/api/rust/index.html || echo '<meta http-equiv=\"refresh\" content=\"0; url=brows3r_lib/\">' > dist-docs/api/rust/index.html)",
    "docs:full": "pnpm docs:build && pnpm docs:api:ts && pnpm docs:api:rust",
    "docs:full:preview": "pnpm docs:full && pnpm docs:preview",
    "postinstall": "lefthook install && node scripts/sync-pdf-worker.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@types/papaparse": "^5.5.2",
    "apache-arrow": "^21.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "i18next": "^26.1.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.14.0",
    "monaco-editor": "^0.55.1",
    "papaparse": "^5.5.3",
    "parquet-wasm": "^0.7.1",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.7",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-resizable-panels": "^4.11.1",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.2",
    "@types/node": "^25.7.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-pdf": "^7.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.6",
    "tailwindcss": "^4.3.0",
    "typedoc": "^0.28.19",
    "typescript": "~6.0.3",
    "vite": "^8.0.12",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.6",
    "vitest-axe": "^0.1.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.3.2",
      "vitepress>vite": "^6.4.2",
      "esbuild": "^0.25.0"
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "esbuild",
      "lefthook"
    ]
  }
}
